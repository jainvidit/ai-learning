{
  "name": "ai-learning-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "content:build": "velite build --clean",
    "content:watch": "velite dev",
    "dev": "velite build && next dev -H 127.0.0.1",
    "dev:e2e": "velite build && next dev -H 127.0.0.1 -p 3001",
    "build:content": "tsx scripts/build-content-bundle.ts",
    "build": "velite build --clean && npm run build:content && next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:e2e": "bash scripts/run-e2e-with-server.sh",
    "verify:e2e:manual": "playwright test",
    "verify:e2e:ui": "playwright test --ui",
    "e2e:server": "next start -H 127.0.0.1 -p 3001",
    "validate": "tsx scripts/validate-content.ts",
    "seed-sandboxes": "tsx scripts/seed-sandboxes.ts"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dagre": "^0.8.5",
    "gray-matter": "^4.0.3",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "reactflow": "^11.11.4",
    "shiki": "^4.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/dagre": "^0.7.54",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "velite": "^0.4.0",
    "vitest": "^4.1.10"
  }
}
